{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --clean --format esm --sourcemap",
    "generate-openapi": "tsx scripts/generate_openapi.ts",
    "ci": "biome ci",
    "test": "firebase emulators:exec 'pnpm vitest run --coverage'",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "@googleapis/calendar": "^14.0.0",
    "@hono/node-server": "^2.0.1",
    "@hono/standard-validator": "^0.3.0",
    "@scalar/hono-api-reference": "^0.11.0",
    "firebase-admin": "^13.8.0",
    "hono": "^4.12.25",
    "hono-openapi": "^1.3.0",
    "luxon": "^3.7.2",
    "zod": "^3.25.76",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.18",
    "@vitest/coverage-v8": "4.1.10",
    "firebase-tools": "^15.15.0",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
