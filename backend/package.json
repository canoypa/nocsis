{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup --entry.main src/main.ts --entry.source_map_worker src/services/source_map_worker.ts --clean --format esm --sourcemap",
    "generate-openapi": "tsx scripts/generate_openapi.ts",
    "grant": "tsx scripts/grant.ts",
    "revoke": "tsx scripts/revoke.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "firebase emulators:exec --project demo-nocsis 'pnpm vitest run --coverage'",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^8.0.0",
    "@googleapis/calendar": "^20.2.0",
    "@hono/node-server": "^2.1.11",
    "@hono/standard-validator": "^0.4.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@scalar/hono-api-reference": "^0.12.25",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "hono": "^4.13.22",
    "hono-openapi": "^1.6.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "5.1.1",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "msw": "^3.0.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.20.0"
}
