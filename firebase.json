{
  "hosting": {
    "public": "./frontend/build/web",
    // ソースマップを読むのは backend だけで、画面には要らない。デプロイのときにバケットに置く
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map"],
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "backend",
          "region": "asia-northeast1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    // Flutter の成果物はファイル名にハッシュを含まないので、ブラウザに既定の
    // 1時間キャッシュさせると、リロードしても古い版が起動する。ETag で確かめさせる
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  // Cloud Run functions のランタイムにはサポート期限がある。
  // 上げる前に対応状況を確認する:
  // https://cloud.google.com/functions/docs/runtime-support#node.js
  "functions": {
    "source": "functions",
    "runtime": "nodejs24"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "singleProjectMode": true,
    "ui": {
      "enabled": true
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8888
    }
  }
}
