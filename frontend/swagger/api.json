              "pop"
            ],
            "description": "時間別天気予報"
          },
          "threeHour": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Rain",
                "Snow",
                "Atmosphere",
                "Clear",
                "Clouds",
                "Unknown"
              ],
              "description": "天候名"
            },
            "description": "3時間先までの天気"
          }
        },
        "required": [
          "current",
          "hourly",
          "threeHour"
