          },
          "events_calendar_id": {
            "type": "string",
            "description": "イベントカレンダーID"
          },
          "dayduty_start_date": {
            "type": "string",
            "description": "日直開始日"
          },
          "slack_event_channel_id": {
            "type": "string",
