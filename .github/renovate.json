{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "dockerfile": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "パッチ・SHAダイジェスト更新は CI が通ったものだけ自動マージする",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "functions(npm) のパッチをまとめる",
      "matchFileNames": ["functions/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "functions patch updates"
    },
    {
      "description": "backend(npm) のパッチをまとめる",
      "matchFileNames": ["backend/**"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "backend patch updates"
    },
    {
      "description": "frontend(pub) のパッチをまとめる",
      "matchFileNames": ["frontend/**"],
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["patch"],
      "groupName": "frontend patch updates"
    },
    {
      "description": "GitHub Actions のパッチをまとめる",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch"],
      "groupName": "github-actions patch updates"
    },
    {
      "description": "mise が管理するツール(flutter/node/pnpm)。CI の mise-action と同じ版を Renovate が追従させる",
      "matchManagers": ["mise"],
      "addLabels": ["mise"]
    },
    {
      "description": "mise管理ツールのpatchはビルド・実行環境全体への変更のため自動マージせず人間レビューを挟む",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch"],
      "automerge": false
    },
    {
      "description": "flutter(mise) 更新は frontend/pubspec.lock の再生成が必要なためマージ前に手動対応を促す",
      "matchManagers": ["mise"],
      "matchDepNames": ["flutter"],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ flutter バージョン更新時は `frontend/pubspec.lock` の再生成が必要です。マージ前に `cd frontend && flutter pub get` を実行し、変更されたロックファイルをこのPRにコミットしてください。"
      ]
    },
    {
      "description": "node ランタイムのメジャー更新と @types/node のメジャー更新をまとめる",
      "matchManagers": ["mise", "npm"],
      "matchDepNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node major"
    }
  ]
}
