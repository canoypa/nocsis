{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on friday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "パッチ・SHA ピン更新は自動マージ（旧 dependabot_auto_merge.yml 相当。CI が通ったものだけマージされる）",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "functions(npm) のパッチをまとめる",
      "matchFileNames": ["functions/**"],
      "matchUpdateTypes": ["patch"],
      "groupName": "functions patch updates"
    },
    {
      "description": "backend(npm) のパッチをまとめる",
      "matchFileNames": ["backend/**"],
      "matchUpdateTypes": ["patch"],
      "groupName": "backend patch updates"
    },
    {
      "description": "frontend(pub) のパッチをまとめる",
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["patch"],
      "groupName": "frontend patch updates"
    },
    {
      "description": "GitHub Actions のパッチをまとめる",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch"],
      "groupName": "github-actions patch updates"
    },
    {
      "description": "@types/node のメジャーは runtime に追従させず追わない（旧 dependabot ignore 相当）",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "mise が管理するツール(flutter/node/pnpm)。CI の mise-action と同じ版を Renovate が追従させる",
      "matchManagers": ["mise"],
      "addLabels": ["mise"]
    }
  ]
}
