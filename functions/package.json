{
  "private": true,
  "name": "nocsis-functions",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ci": "biome ci src",
    "format": "biome format src",
    "test": "firebase emulators:exec --project demo-nocsis 'pnpm vitest run --coverage'",
    "test:watch": "vitest watch --coverage",
    "build": "tsup src/main.ts -d dist --format esm --clean --sourcemap",
    "build:watch": "tsup src/main.ts -d dist --format esm --clean --sourcemap --watch",
    "serve": "pnpm run serve-emulator",
    "serve-emulator": "firebase emulators:start --project demo-nocsis --only functions",
    "shell": "pnpm run build && firebase functions:shell --project demo-nocsis",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --project \"${FIREBASE_PROJECT:?FIREBASE_PROJECT is not set}\" --only functions",
    "logs": "firebase functions:log --project \"${FIREBASE_PROJECT:?FIREBASE_PROJECT is not set}\""
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/secret-manager": "^6.1.1",
    "@googleapis/calendar": "^16.0.0",
    "@slack/web-api": "^8.0.0",
    "cron-parser": "^5.5.0",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.1.1",
    "luxon": "^3.7.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.8.0",
    "msw": "^2.12.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0",
    "vitest": "^4.1.4"
  }
}
