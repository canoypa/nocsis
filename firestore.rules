rules_version = '2';

// このアプリはクライアントから Firestore へ直接アクセスしない。
// backend (Cloud Run) / functions は Admin SDK 経由でルールを迂回するため、
// クライアント経路は全面的に拒否する。将来クライアント直アクセスが必要になった
// 場合のみ、対象コレクションに限定して緩和すること。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
