rules_version = '2';

// クライアントは Firestore を直接読まない。backend (Cloud Run) / functions は
// Admin SDK でルールを迂回する。教室ディスプレイが登録の解除にすぐ気づけるよう、
// 自分の付与を読むことだけを開ける。
service cloud.firestore {
  match /databases/{database}/documents {
    match /role_bindings/{bindingId} {
      allow get, list: if request.auth != null
        && resource.data.subject == 'user:' + request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
