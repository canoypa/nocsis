{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
    ":configMigration"
  ],
  "enabledManagers": ["mise", "github-actions", "dockerfile", "npm", "pub", "terraform", "custom.regex"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "dockerfile マネージャが見ない backend/Dockerfile の pnpm バージョンを追跡する",
      "managerFilePatterns": ["backend/Dockerfile"],
      "matchStrings": ["(^|\\n)ENV PNPM_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "github-actions マネージャが見ない gh-actions-lock 拡張のバージョンを追跡する",
      "managerFilePatterns": [".github/workflows/ci.yml"],
      "matchStrings": ["GH_ACTIONS_LOCK_VERSION:\\s*(?<currentValue>v\\S+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "どのマネージャも見ない firebase.json の functions ランタイムを追跡する",
      "managerFilePatterns": ["firebase.json"],
      "matchStrings": ["\"runtime\"\\s*:\\s*\"nodejs(?<currentValue>\\d+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "pub マネージャが見ない pubspec.yaml の Flutter SDK 要求バージョンを追跡する",
      "managerFilePatterns": ["frontend/pubspec.yaml"],
      "matchStrings": ["(^|\\n)environment:\\n(?:.*\\n)*?  flutter:[ \\t]*\"(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "flutter",
      "packageNameTemplate": "flutter/flutter",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "pub マネージャが見ない analysis_options.yaml の analyzer プラグインを追跡する",
      "managerFilePatterns": ["frontend/analysis_options.yaml"],
      "matchStrings": ["(^|\\n)plugins:\\n(?:  .*\\n)*?  (?<depName>[a-z0-9_]+):[ \\t]*(?<currentValue>\\^?[\\d.]+)"],
      "datasourceTemplate": "dart",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "パッチ・SHAダイジェスト更新の自動マージ",
      "matchManagers": ["npm", "pub", "github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "prPriority": 1,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0,
      "prHourlyLimit": 0
    },
    {
      "description": "lockfile を共有する minor 更新をディレクトリ単位でまとめる",
      "matchManagers": ["npm", "pub"],
      "matchUpdateTypes": ["minor"],
      // ルートの package.json は packageFileDir が空になるので root と表示する
      "groupName": "minor dependencies ({{#if packageFileDir}}{{packageFileDir}}{{else}}root{{/if}})"
    },
    {
      "description": "互いのバージョンを要求し合う Firebase の Flutter パッケージをまとめる",
      "matchManagers": ["pub"],
      "matchPackageNames": ["firebase_core", "firebase_auth", "firebase_auth_mocks"],
      "groupName": "firebase (frontend)"
    },
    {
      "description": "node のバージョンを定義している5箇所のメジャー更新をまとめる",
      "matchManagers": ["mise", "npm", "dockerfile", "custom.regex"],
      "matchDepNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node major"
    },
    {
      "description": "mise.toml と backend/Dockerfile が定義する node のマイナー・パッチ更新をまとめる",
      "matchManagers": ["mise", "dockerfile"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "node"
    },
    {
      "description": "pnpm のバージョンを定義している5箇所をまとめる",
      "matchManagers": ["mise", "npm", "custom.regex"],
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Flutter のバージョンと Dart SDK の下限を揃えて更新する",
      "matchManagers": ["mise", "pub", "custom.regex"],
      "matchDepNames": ["flutter", "dart"],
      // pubspec.yaml の sdk (^x.y.z) は新しい Dart も範囲に含むため、既定では書き換えられない。
      // bump にして、Flutter に同梱の Dart まで下限を上げる。
      "rangeStrategy": "bump",
      "groupName": "flutter",
      // グループ PR のタイトルに Flutter のバージョンを出す (mise.toml の flutter は depType が tools)
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#each upgrades}}{{#if (equals depType \"tools\")}} to v{{{newVersion}}}{{/if}}{{/each}}"
      }
    },
    {
      "description": "Dart SDK の下限を caret の範囲のまま上げる",
      "matchManagers": ["pub"],
      "matchDepNames": ["dart"],
      // dart-version データソースの既定は semver で、^3.10.0 が 3.14.0 に置き換わってしまう
      "versioning": "npm"
    },
    {
      "description": "Dart SDK のパッチ更新は Flutter の同梱版より先に出るので追わない",
      "matchManagers": ["pub"],
      "matchDepNames": ["dart"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "npm の依存の範囲指定を最新に追従させる",
      "matchManagers": ["npm"],
      // 範囲内の更新でも package.json の下限を上げる。
      "rangeStrategy": "bump"
    }
  ]
}
